# Neo Autonomous Cognitive OS Configuration
# Zero external cloud AI provider keys are required or used by Neo.
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Required in production. Generate with: openssl rand -hex 32
NEO_SESSION_SECRET=
# Number of trusted reverse-proxy hops; keep 0 when exposing Neo directly.
NEO_TRUST_PROXY_HOPS=0
# Docker Compose PostgreSQL credential; use a long alphanumeric value.
POSTGRES_PASSWORD=

# Database & Persistent Vector Memory
# Omit DATABASE_URL to use zero-config persistent local SQLite (./data/neo.sqlite)
# DATABASE_URL="postgresql://neo:neo_dev_password@127.0.0.1:5432/neo"
SQLITE_DB_PATH="./data/neo.sqlite"

# Optional Redis + BullMQ distributed daemon queue (falls back to persistent SQLite queue)
# REDIS_URL="redis://127.0.0.1:6379"

# Sovereign Local & Self-Hosted Model Runtimes
# NEO_RUNTIME_DEFAULT: auto | embedded | ollama | vllm | tensorrt-llm | transformers
NEO_RUNTIME_DEFAULT="auto"
NEO_PRIMARY_MODEL="qwen2.5:3b-instruct"
NEO_EMBEDDING_MODEL="neo-embed-local-v2"
NEO_MODELS_DIR="./data/models"

# Optional Self-Hosted GPU/CPU Runtime Endpoints
# NEO_OLLAMA_BASE_URL="http://127.0.0.1:11434"
# NEO_VLLM_BASE_URL="http://127.0.0.1:8000"
# NEO_TENSORRT_LLM_BASE_URL=""
# NEO_HF_INFERENCE_BASE_URL=""

# Security & Sandbox Isolation
# Set ADMIN_PASSCODE in production (otherwise claim initial passcode in UI / /api/admin/auth/claim)
# ADMIN_PASSCODE=""
# NEO_CORS_ORIGINS="http://localhost:3000"
# NEO_SANDBOX_MODE: subprocess | docker
NEO_SANDBOX_MODE="subprocess"

# Background Learning & Priority-Aware Scheduler
NEO_KNOWLEDGE_INTERVAL_MS=1800000
NEO_SCHEDULER_ENABLED="true"
NEO_SCHEDULER_TICK_MS=60000
NEO_AUTO_MERGE_SAFE_UPGRADES="false"

# Optional Search Adapters (DuckDuckGo HTML / arXiv / Wikipedia / GitHub work keylessly)
# TAVILY_API_KEY=""
# BRAVE_SEARCH_API_KEY=""
# SERPER_API_KEY=""
