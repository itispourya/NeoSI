# Neo Sovereign Standalone Mode (set NEO_LOCAL_ONLY=true to run 100% independently of external neural APIs)
NEO_LOCAL_ONLY=false
NEO_INFERENCE_URL=
NEO_INFERENCE_MODEL=neo-core-instruct

# Optional Neural Compute & Router Providers
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Optional Web Search & Crawling Providers (falls back to Neo GitHub/arXiv/Direct HTTP + Grounded Index)
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
FIRECRAWL_API_KEY=

# Production Persistence & Queue (falls back to embedded node:sqlite + persistent worker queue if unset)
DATABASE_URL=
REDIS_URL=

# Autonomous Self-Upgrade & Security Controls
AUTO_MERGE_SAFE_UPGRADES=false
KNOWLEDGE_DAEMON_INTERVAL_MS=900000
NEO_ADMIN_PASSCODE=
NEOS_WEBHOOK_SECRET=
